[Unit]
Description=InboxOps - dashboard (Next.js)
After=network-online.target inboxops-backend.service
Wants=network-online.target

[Service]
Type=simple
User=inboxops
Group=inboxops
WorkingDirectory=/opt/inboxops/dashboard
EnvironmentFile=/opt/inboxops/dashboard/.env.local
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
