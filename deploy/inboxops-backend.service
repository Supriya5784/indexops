[Unit]
Description=InboxOps - backend (poller + API)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=inboxops
Group=inboxops
WorkingDirectory=/opt/inboxops
EnvironmentFile=/opt/inboxops/.env
ExecStart=/opt/inboxops/.venv/bin/python main.py
Restart=on-failure
RestartSec=5
# Auto-restart forever, but back off if it's crash-looping
StartLimitIntervalSec=300
StartLimitBurst=10

# Hardening — the service only needs its own directory and outbound network
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/inboxops/data

[Install]
WantedBy=multi-user.target
